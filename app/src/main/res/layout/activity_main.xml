<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btnOpen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open Video"/>
        <Button android:id="@+id/btnAnalyze" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Analyze Scenes"/>
        <Button android:id="@+id/btnDelete" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Delete Selected"/>
        <Button android:id="@+id/btnSplit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Splitter"/>
        <Button android:id="@+id/btnMerge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Merge/Join"/>
    </LinearLayout>
    <TextView android:id="@+id/txtStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Select a video to begin" android:padding="6dp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/sceneRecycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
